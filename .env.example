# Copy this file to .env.local and fill in the values from
# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server only. Never expose this in the browser.
# Used by the client tracking page (/t/...) so clients need no login.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The public address of the app, used when copying a client's tracking link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
